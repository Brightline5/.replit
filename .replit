run = "npm run dev"
modules = ["nodejs-20", "postgresql-16"]

[deployment]
run = ["sh", "-c", "npm start"]
deploymentTarget = "gce"
ignorePorts = false
build = ["sh", "-c", "npm run build"]

[nix]
channel = "stable-25_05"
packages = ["lsof"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

