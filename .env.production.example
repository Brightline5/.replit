# Production Environment Variables
# IMPORTANT: Add these as Deployment Secrets in your hosting platform
# DO NOT use a .env file in production - it will not be loaded

# Required - Application Environment
NODE_ENV=production

# Required - Server Port (must be 5000 for Replit deployments)
PORT=5000

# Required - Database Connection
DATABASE_URL=postgres://username:password@hostname:5432/database_name

# Required - Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-super-secret-session-key-minimum-32-characters

# Required if using StackFrame Authentication
STACK_PROJECT_ID=your-stack-project-id
STACK_PUBLISHABLE_CLIENT_KEY=your-stack-publishable-client-key
STACK_SECRET_SERVER_KEY=your-stack-secret-server-key
